<Window x:Class="MandrillSimulator.ConnectProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect a project"
        Height="330" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource UiFont}">

    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Style="{StaticResource Secondary}" Margin="0,0,0,16"
                   Text="Pick any JSON configuration file and the key that holds the Mandrill base URL. The simulator writes its own URL into that key and keeps a .bak copy so Disconnect can put the original back. Nothing here is specific to one codebase." />

        <TextBlock Text="Configuration file" Style="{StaticResource SectionHeading}" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
        </Grid>

        <TextBlock Text="Key path" Style="{StaticResource SectionHeading}" />
        <TextBox x:Name="KeyBox" Text="AppSetting:MandrillBaseUrl" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource Secondary}" FontSize="11" Margin="0,0,0,14"
                   Text="Colon or dot separated, e.g. AppSetting:MandrillBaseUrl. Missing levels are created." />

        <Border Background="{DynamicResource CodeBackground}" BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,18">
            <TextBlock x:Name="PreviewText" Style="{StaticResource Mono}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Margin="0,0,8,0" Click="OnCancel" MinWidth="90" />
            <Button Content="Connect" Style="{StaticResource AccentButton}" Click="OnConnect" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
