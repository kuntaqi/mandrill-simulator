<Window x:Class="MandrillSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:models="clr-namespace:MandrillSimulator.Models"
        Title="Mandrill Simulator"
        Height="880" Width="1480"
        MinHeight="620" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{DynamicResource WindowBackground}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="Connect a project to this simulator…" Click="OnConnectProject" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Server">
                <MenuItem Header="Start" Command="{Binding StartServerCommand}" />
                <MenuItem Header="Stop" Command="{Binding StopServerCommand}" />
                <Separator />
                <MenuItem Header="Send sample message" Command="{Binding SendSampleCommand}" />
            </MenuItem>
            <MenuItem Header="Si_mulate">
                <MenuItem Header="Open on selected message" Command="{Binding SimulateOpenCommand}" />
                <MenuItem Header="Click on selected message" Command="{Binding SimulateClickCommand}" />
                <MenuItem Header="Reset counters" Command="{Binding ResetCountersCommand}" />
                <Separator />
                <MenuItem Header="Fail the next API call (500)" Command="{Binding FailNextRequestCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Dark theme" IsCheckable="True" IsChecked="{Binding IsDarkTheme}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,1" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by recipient, subject or _id" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="Send sample message" Command="{Binding SendSampleCommand}" Margin="0,0,8,0" />
                    <Button Content="Clear all" Command="{Binding ClearAllCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Secondary}"
                           Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" MaxWidth="620" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="266" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="430" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Left rail -->
            <Border Grid.Column="0" Background="{DynamicResource RailBackground}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Margin="12" Content="Clear all messages"
                            Command="{Binding ClearAllCommand}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,12,12,0">
                            <TextBlock Text="SERVER" Style="{StaticResource SectionHeading}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#8A8A8A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Fill" Value="#1A7F37" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ServerStatusText}" FontWeight="SemiBold" />
                            </StackPanel>

                            <Border Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Mono}"
                                               Text="{Binding ListeningUrl}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Content="Copy" Padding="6,2" FontSize="11"
                                            Click="OnCopyUrl" />
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Style="{StaticResource Secondary}" />
                                <TextBox Width="80" Text="{Binding Port, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>

                            <Button Content="Start server" Style="{StaticResource AccentButton}"
                                    Command="{Binding StartServerCommand}" Margin="0,0,0,4"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <Button Content="Stop server" Command="{Binding StopServerCommand}" Margin="0,0,0,4"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="Connect a project…" Margin="0,8,0,0" Click="OnConnectProject" />

                            <ItemsControl ItemsSource="{Binding ConnectedProjects}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PanelBackground}"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1" CornerRadius="4" Padding="7,5" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ConfigPath}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ConfigPath}" />
                                                <TextBlock Text="{Binding KeyPath}" FontSize="10"
                                                           Style="{StaticResource Secondary}" />
                                                <Button Content="Disconnect" FontSize="10" Padding="5,2"
                                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                                        Command="{Binding DataContext.DisconnectProjectCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="ENDPOINTS" Style="{StaticResource SectionHeading}" Margin="0,16,0,6" />
                            <ItemsControl ItemsSource="{Binding EndpointHits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Path}" FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Hits}" FontSize="11"
                                                       FontWeight="SemiBold" Margin="6,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="MESSAGES" Style="{StaticResource SectionHeading}" Margin="0,16,0,6" />
                            <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="210">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="TAGS" Style="{StaticResource SectionHeading}" Margin="0,16,0,6"
                                       Visibility="{Binding TagFilters.Count, Converter={StaticResource CountToVisibility}}" />
                            <ListBox ItemsSource="{Binding TagFilters}" SelectedItem="{Binding SelectedFilter}"
                                     BorderThickness="0" Background="Transparent" Margin="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="210">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Message list -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,9"
                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Messages" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="8,0,0,0" FontSize="12"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding MessageCount, Mode=OneWay}" />
                                <Run Text="captured · newest first" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Margin="16,24" TextWrapping="Wrap"
                               Style="{StaticResource Secondary}"
                               Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                               Text="Nothing captured yet. Point an application at the URL in the rail, or use Send sample message to check the simulator end to end." />

                    <ListBox ItemsSource="{Binding MessagesView}" SelectedItem="{Binding SelectedMessage}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CapturedMessage}">
                                <Border Padding="4,7" BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ToEmail}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding ReceivedAt, StringFormat=HH:mm:ss}"
                                                       FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        </Grid>

                                        <TextBlock Text="{Binding Subject}" Margin="0,2,0,5"
                                                   Style="{StaticResource Secondary}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Border BorderThickness="1" CornerRadius="3" Padding="5,1"
                                                        Margin="0,0,5,0"
                                                        BorderBrush="{Binding StateWire, Converter={StaticResource StateBrush}}">
                                                    <TextBlock Text="{Binding StateWire}" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StateWire, Converter={StaticResource StateBrush}}" />
                                                </Border>
                                                <Border Background="{DynamicResource ChipBackground}" CornerRadius="3"
                                                        Padding="5,1">
                                                    <TextBlock Text="{Binding DisplayTags}" FontSize="10"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                           Margin="0,0,8,0">
                                                    <Run Text="opens" />
                                                    <Run Text="{Binding Opens, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}">
                                                    <Run Text="clicks" />
                                                    <Run Text="{Binding Clicks, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Detail -->
            <Grid Grid.Column="4" Background="{DynamicResource PanelBackground}">
                <TextBlock Margin="24" TextWrapping="Wrap" Style="{StaticResource Secondary}"
                           VerticalAlignment="Top"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                           Text="Select a message to read it, inspect the exact request the caller sent, and drive its opens, clicks and delivery state." />

                <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,0">
                        <TextBlock Text="{Binding SelectedMessage.Subject}" FontSize="17" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <WrapPanel Margin="0,7,0,0">
                            <TextBlock Text="{Binding SelectedMessage.FromEmail}" Style="{StaticResource Secondary}" />
                            <TextBlock Text="  →  " Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding SelectedMessage.ToEmail}" Style="{StaticResource Secondary}"
                                       Margin="0,0,8,0" />
                            <Border BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                    BorderBrush="{Binding SelectedMessage.StateWire, Converter={StaticResource StateBrush}}">
                                <TextBlock Text="{Binding SelectedMessage.StateWire}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding SelectedMessage.StateWire, Converter={StaticResource StateBrush}}" />
                            </Border>
                            <Border Background="{DynamicResource ChipBackground}" CornerRadius="3" Padding="5,1">
                                <TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="_id" />
                                    <Run Text="{Binding SelectedMessage.Id, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Interaction simulator -->
                    <Border DockPanel.Dock="Top" Margin="16,12,16,0" CornerRadius="5" Padding="12,10"
                            Background="{DynamicResource SimulatorStripBackground}"
                            BorderBrush="{DynamicResource SimulatorStripBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="INTERACTION SIMULATOR" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,0,8" />

                            <WrapPanel>
                                <Button Style="{StaticResource AccentButton}" Margin="0,0,8,6"
                                        Command="{Binding SimulateOpenCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Simulate open" Foreground="{DynamicResource AccentText}" />
                                        <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,0" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding SelectedMessage.Opens}" FontSize="11"
                                                       Foreground="{DynamicResource AccentText}" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource AccentButton}" Margin="0,0,8,6"
                                        Command="{Binding SimulateClickCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Simulate click" Foreground="{DynamicResource AccentText}" />
                                        <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,0" Margin="7,0,0,0">
                                            <TextBlock Text="{Binding SelectedMessage.Clicks}" FontSize="11"
                                                       Foreground="{DynamicResource AccentText}" />
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <ComboBox Width="150" Margin="0,0,8,6" ItemsSource="{Binding AvailableStates}"
                                          SelectedItem="{Binding SelectedMessage.StateWire, Mode=OneWay}"
                                          SelectionChanged="OnStateSelectionChanged"
                                          ToolTip="Set the state messages/search will report" />

                                <Button Content="Reset counters" Margin="0,0,8,6"
                                        Command="{Binding ResetCountersCommand}" />
                            </WrapPanel>

                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="These counters are what messages/search reports back for this _id. A polling job in the application under test reads them from there." />
                        </StackPanel>
                    </Border>

                    <TabControl Margin="16,12,16,16" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Preview">
                            <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,8,0,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Background="{DynamicResource CodeBackground}"
                                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1"
                                            Padding="9,5">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                   Text="WebView2 · scripts disabled, external navigation blocked" />
                                    </Border>
                                    <wv2:WebView2 x:Name="PreviewBrowser" />
                                </DockPanel>
                            </Border>
                        </TabItem>

                        <TabItem Header="HTML source">
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding SelectedMessage.Html, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         TextWrapping="NoWrap" BorderThickness="1"
                                         Background="{DynamicResource CodeBackground}" />
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Headers">
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="_id" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedMessage.Id}" Style="{StaticResource Mono}" Margin="0,0,0,7" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="status" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMessage.StateWire}" Style="{StaticResource Mono}" Margin="0,0,0,7" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="reject_reason" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedMessage.RejectReason}" Style="{StaticResource Mono}" Margin="0,0,0,7" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="bounce_description" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedMessage.BounceDescription}" Style="{StaticResource Mono}" Margin="0,0,0,7" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="from" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedMessage.FromEmail}" Style="{StaticResource Mono}" Margin="0,0,0,7" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="to" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedMessage.ToEmail}" Style="{StaticResource Mono}" Margin="0,0,0,7" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="tags" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedMessage.DisplayTags}" Style="{StaticResource Mono}" Margin="0,0,0,7" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="opens / clicks" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Mono}" Margin="0,0,0,7">
                                        <Run Text="{Binding SelectedMessage.Opens, Mode=OneWay}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding SelectedMessage.Clicks, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="track_opens / clicks" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Mono}" Margin="0,0,0,7">
                                        <Run Text="{Binding SelectedMessage.TrackOpens, Mode=OneWay}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding SelectedMessage.TrackClicks, Mode=OneWay}" />
                                    </TextBlock>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="received" Style="{StaticResource Secondary}" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedMessage.ReceivedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Style="{StaticResource Mono}" Margin="0,0,0,7" />

                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="ts (unix)" Style="{StaticResource Secondary}" />
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedMessage.UnixTimestamp}" Style="{StaticResource Mono}" />
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Attachments">
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="No attachments on this message."
                                               Style="{StaticResource Secondary}" Margin="4,8"
                                               Visibility="{Binding SelectedAttachments.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />

                                    <ItemsControl ItemsSource="{Binding SelectedAttachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,7"
                                                        Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondary}">
                                                                <Run Text="{Binding Type, Mode=OneWay}" />
                                                                <Run Text="·" />
                                                                <Run Text="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource FileSize}}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Save as…"
                                                                Command="{Binding DataContext.SaveAttachmentCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Embedded images (cid)" Style="{StaticResource SectionHeading}"
                                               Margin="0,10,0,6"
                                               Visibility="{Binding SelectedEmbeddedImages.Count, Converter={StaticResource CountToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding SelectedEmbeddedImages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,7"
                                                        Margin="0,0,0,6">
                                                    <TextBlock>
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource FileSize}}" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Raw JSON">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Text="{Binding SelectedMessage.RawRequestJson, Mode=OneWay}"
                                         IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="{DynamicResource CodeBackground}" />

                                <TextBlock Grid.Row="1" Text="Response returned to the caller"
                                           Style="{StaticResource SectionHeading}" Margin="0,10,0,4" />

                                <TextBox Grid.Row="2" Text="{Binding SelectedMessage.RawResponseJson, Mode=OneWay}"
                                         IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="{DynamicResource CodeBackground}" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource RailBackground}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           Text="{Binding LastRequestText}" />
                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           Text="Loopback only · in-memory store" />
            </Grid>
        </Border>
    </Grid>
</Window>
